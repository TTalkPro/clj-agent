{:paths ["src"]

 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
            "clojars" {:url "https://repo.clojars.org/"}}

 :deps {org.clojure/clojure {:mvn/version "1.11.4"}}
 ;; 无内部/外部依赖：core 只含 protocol/契约（im.ttalk.agent.model.*）+ kernel 原语。
 ;; Agent 运行时（client/react/memory/subagent，含 timbre/next.jdbc/sqlite 依赖）
 ;; 已下沉 clj-agent-client（2026-07，onion-filter 设计）。

 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.0.0"}
                     cider/cider-nrepl {:mvn/version "0.30.0"}}}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.85.1342"}
                      lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
         :main-opts ["-m" "kaocha.runner"]}
}}
