{:paths ["modules/clj-agent-core/src"
          "modules/clj-agent-client/src"
          "modules/clj-agent-provider/src"
          "modules/clj-agent-mcp/src"
          "modules/clj-agent-agui/src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}

        ;; JSON
        cheshire/cheshire {:mvn/version "5.12.0"}

        ;; 日志
        com.taoensso/timbre {:mvn/version "6.3.0"}

        ;; 持久化 ChatMemory（SQLite 后端，按需加载 core.memory.sqlite）
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
        org.xerial/sqlite-jdbc {:mvn/version "3.45.1.0"}}
 :aliases {:test {:extra-paths ["modules/clj-agent-provider/test"
                               "modules/clj-agent-client/test"
                               "modules/clj-agent-core/test"
                               "modules/clj-agent-mcp/test"
                               "modules/clj-agent-agui/test"]
                 :extra-deps {lambdaisland/kaocha {:mvn/version "1.85.1342"}}
                 :main-opts ["-m" "kaocha.runner"]}

           ;; CopilotKit 联调示例的 web 依赖——**只在这个 alias 里**
           ;; （design-principles §2.2：集成代码只进 examples/，web 依赖不进核心 :deps）
           :copilotkit {:extra-paths ["examples"]     ;; 让 examples/copilotkit/*.clj 能 require
                        :extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}}}

           ;; MCP server 示例的 web 依赖——**只在这个 alias 里**（同 :copilotkit 的理由）
           :mcp {:extra-paths ["examples"]
                 :extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}}}

           ;; 各模块的构建/发布统一在根 build.clj（见其 ns docstring）
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                          slipset/deps-deploy {:mvn/version "0.2.2"}}
                   :ns-default build}}}
